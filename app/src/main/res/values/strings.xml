<resources>
    <string name="app_name">桌寵夥伴</string>
    <string name="launcher_title">讓新夥伴住進你的桌面</string>
    <string name="launcher_body">10 位新夥伴已準備好陪你工作和休息。啟動後可以拖曳角色、點一下聊天、連點玩耍、長按切換角色或餵食，也能雙指調整大小。\n\n要讓桌寵浮在其他 App 上方，請允許「顯示在其他應用程式上層」。如果想讓夥伴在切換 App 時聊天，還需要開啟「使用量資料存取」。</string>
    <string name="overlay_permission_title">允許桌寵顯示在其他 App 上方</string>
    <string name="overlay_permission_body">請允許「顯示在其他應用程式上層」。若要讓夥伴在開啟／關閉其他 App 時說話，還需要「使用量資料存取」。\n\n從 APK 安裝時，三星可能會限制使用量權限。請先開啟應用程式資訊，點右上角 ⋮，選擇「允許受限制的設定」，再回去打開使用量權限。</string>
    <string name="overlay_permission_button">開啟上層顯示權限</string>
    <string name="start_pet_button">啟動桌寵</string>
    <string name="stop_pet_button">停止桌寵</string>
    <string name="stay_on_top_on">最上層置頂：開</string>
    <string name="stay_on_top_off">最上層置頂：關</string>
    <string name="notification_on_top">桌寵正在顯示於其他 App 上層</string>
    <string name="notification_not_on_top">桌寵未置頂，不會蓋住其他 App</string>
    <string name="action_unpin">取消置頂</string>
    <string name="action_pin">保持置頂</string>
    <string name="usage_access_button">開啟使用量資料存取</string>
    <string name="restricted_settings_button">允許受限制的設定</string>
</resources>
